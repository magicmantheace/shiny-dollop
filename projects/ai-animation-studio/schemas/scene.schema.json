{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-animation-studio/scene.schema.json",
  "title": "Validated AI director scene v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scene_id",
    "environment_id",
    "actors",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "scene_id": {
      "$ref": "#/$defs/id"
    },
    "environment_id": {
      "$ref": "#/$defs/id"
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional speak-timing overrides (ADR-009). Defaults: rate 15 chars/sec, clamps 800..15000 ms. The min <= max cross-check is enforced by studio/schema.py.",
      "properties": {
        "speak_chars_per_second": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "speak_min_hold_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "speak_max_hold_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "recipe_id",
          "color"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "recipe_id": {
            "$ref": "#/$defs/id"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": [
          "at_ms",
          "op"
        ],
        "properties": {
          "at_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600000
          },
          "op": {
            "enum": [
              "spawn",
              "move",
              "speak",
              "emote",
              "camera"
            ]
          },
          "actor_id": {
            "$ref": "#/$defs/id"
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -1000,
              "maximum": 1000
            }
          },
          "target": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -1000,
              "maximum": 1000
            }
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 60000
          },
          "line": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "emotion": {
            "enum": [
              "neutral",
              "happy",
              "sad",
              "angry",
              "nervous",
              "surprised",
              "tired",
              "scared"
            ]
          },
          "intensity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "shot": {
            "enum": [
              "wide",
              "two_shot",
              "close_left",
              "close_right"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    }
  }
}
