# Underreach local production media providers
# These values mirror install-underreach-media-pipeline.bat exactly.
# The production stack rejects different writer/verifier/image model identities.

UNDERREACH_PROVIDER_OLLAMA_ENABLED=true
UNDERREACH_PROVIDER_OLLAMA_BASE_URL=http://127.0.0.1:11434
UNDERREACH_PROVIDER_OLLAMA_WRITER_MODEL=qwen3:8b
UNDERREACH_PROVIDER_OLLAMA_VERIFIER_MODEL=qwen3:4b
UNDERREACH_PROVIDER_OLLAMA_KEEP_ALIVE=0

UNDERREACH_PROVIDER_COMFYUI_IMAGE_ENABLED=true
UNDERREACH_PROVIDER_COMFYUI_VIDEO_ENABLED=true
UNDERREACH_PROVIDER_COMFYUI_BASE_URL=http://127.0.0.1:8188
UNDERREACH_PROVIDER_COMFYUI_IMAGE_CHECKPOINT=sd_xl_base_1.0.safetensors

# Crawl ships an API-format graph for the exact Wan assets pulled by the BAT:
#   wan2.2_ti2v_5B_fp16.safetensors
#   umt5_xxl_fp8_e4m3fn_scaled.safetensors
#   wan2.2_vae.safetensors
UNDERREACH_PROVIDER_COMFYUI_VIDEO_WORKFLOW_PATH=config/comfyui/wan2.2-ti2v-5b-api.json
UNDERREACH_PROVIDER_COMFYUI_VIDEO_GENERATION_WIDTH=432
UNDERREACH_PROVIDER_COMFYUI_VIDEO_GENERATION_HEIGHT=768
UNDERREACH_PROVIDER_COMFYUI_VIDEO_GENERATION_FPS=16
UNDERREACH_PROVIDER_COMFYUI_VIDEO_MAX_FRAMES=81
UNDERREACH_PROVIDER_COMFYUI_FREE_GPU_AFTER_IMAGE=false
UNDERREACH_PROVIDER_COMFYUI_FREE_GPU_AFTER_VIDEO=true

# Production voice defaults to the dedicated Python environment and exact
# Kokoro-82M v1.0 files installed under ../CrawlMedia. No Kokoro web service is
# required. Set UNDERREACH_MEDIA_HOME before launching Crawl if the installer was
# pointed at a different media directory.
UNDERREACH_PROVIDER_KOKORO_ENABLED=true
UNDERREACH_PROVIDER_KOKORO_BACKEND=subprocess
UNDERREACH_PROVIDER_KOKORO_VOICE=af_bella
UNDERREACH_PROVIDER_KOKORO_SPEED=1.0

# Optional HTTP development backend. Production does not require this.
# UNDERREACH_PROVIDER_KOKORO_BACKEND=http
# UNDERREACH_PROVIDER_KOKORO_BASE_URL=http://127.0.0.1:8880/v1
# UNDERREACH_PROVIDER_KOKORO_MODEL=kokoro

# Keep deterministic fallbacks enabled. The router prefers healthy production
# providers because their quality ranks are higher.
UNDERREACH_PROVIDER_DETERMINISTIC_IMAGE_FALLBACK_ENABLED=true
UNDERREACH_PROVIDER_DETERMINISTIC_VOICE_FALLBACK_ENABLED=true
UNDERREACH_PROVIDER_DETERMINISTIC_VIDEO_FALLBACK_ENABLED=true

UNDERREACH_PROVIDER_FFMPEG_PATH=ffmpeg
UNDERREACH_PROVIDER_FFPROBE_PATH=ffprobe
