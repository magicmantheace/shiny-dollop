{
  "description": "Windows Game Performance Profiles — reversible, consented per-game performance settings",
  "license": "UNLICENSED",
  "main": "dist/main/main.js",
  "name": "game-performance-profiles",
  "private": true,
  "scripts": {
    "build": "npm run build:renderer && npm run build:main",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "lint": "eslint electron shared tests scripts src/gpp-api.d.ts --max-warnings 0",
    "smoke": "xvfb-run -a node_modules/.bin/electron --no-sandbox dist/main/main.js --smoke",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:ui": "vitest run --config vitest.ui.config.ts"
  },
  "version": "0.1.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "jsdom": "^26.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
