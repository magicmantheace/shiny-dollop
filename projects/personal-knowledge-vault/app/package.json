{
  "author": "magicmantheace",
  "dependencies": {
    "zod": "4.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "description": "Personal Knowledge Vault \u2014 offline, source-linked knowledge capture with review, provenance and corrections. Windows desktop (Electron).",
  "devDependencies": {
    "@types/node": "26.6.5",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^26.1.0",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "main": "dist/electron/main.js",
  "name": "personal-knowledge-vault",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "lint": "eslint .",
    "package:win": "electron-builder --win --x64",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.renderer.json",
    "build:renderer": "vite build",
    "dev:renderer": "vite"
  },
  "version": "0.1.0"
}
