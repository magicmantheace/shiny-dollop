+static void
+panel_task_leave_handler(struct widget *widget, struct input *input,
+			 void *data)
+{
+	struct panel_task *ptask = data;
+
+	ptask->focused = 0;
+	widget_destroy_tooltip(widget);
+	widget_schedule_redraw(widget);
