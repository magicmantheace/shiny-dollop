+/* ---- Start menu items ---- */
+
+static void
+panel_menu_item_activate(struct panel_menu_item *item)
+{
+	struct desktop *desktop = panel_get_desktop(item->panel);
+	struct synveil_task *task;
+	pid_t pid;
+
+	/* Focus-or-launch for the single-instance Synveil apps:
+	 * when a window with the app's id exists, the menu entry
+	 * raises it instead of starting a second copy. */
+	if (item->app_id && desktop->synveil_panel) {
+		wl_list_for_each(task, &desktop->synveil_tasks, link) {
+			if (task->app_id &&
+			    strcmp(task->app_id, item->app_id) == 0) {
+				synveil_shell_panel_activate_window(
+					desktop->synveil_panel, task->id);
+				return;
+			}
+		}
+	}
+
+	pid = fork();
+	if (pid < 0)
+		return;
+	if (pid)
+		return;
+	if (setsid() == -1)
+		exit(EXIT_FAILURE);
+	{
+		char *const argv_with_arg[] = {
+			(char *) item->path, (char *) item->arg, NULL
+		};
+		char *const argv_plain[] = { (char *) item->path, NULL };
+
+		execv(item->path, item->arg ? argv_with_arg : argv_plain);
+		fprintf(stderr, "exec '%s' failed: %s\n", item->path,
+			strerror(errno));
+		exit(1);
+	}
+}
+
+static void
+panel_menu_item_redraw_handler(struct widget *widget, void *data)
+{
+	struct panel_menu_item *item = data;
+	cairo_t *cr;
+	struct rectangle alloc;
+	cairo_text_extents_t extents;
+
+	widget_get_allocation(widget, &alloc);
+	if (alloc.width == 0)
+		return;
+
+	cr = widget_cairo_create(item->panel->widget);
+	if (item->focused) {
+		sv_rounded_rect(cr, alloc.x, alloc.y, alloc.width,
+				alloc.height, 4);
+		sv_set_rgb(cr, SV_COLOR_SURFACE_HI);
+		cairo_fill(cr);
+	}
+	/* Glyph: accent rounded square carrying the app's
+	 * initial — an original geometric mark, no artwork. */
+	sv_rounded_rect(cr, alloc.x + 4, alloc.y + 4, 28, 28, 4);
+	sv_set_rgb(cr, SV_COLOR_ACCENT);
+	cairo_fill(cr);
+	cairo_set_source_rgb(cr, 0x20 / 255.0, 0x20 / 255.0, 0x20 / 255.0);
+	cairo_set_font_size(cr, 15);
+	{
+		char initial[2] = { item->name[0], '\0' };
+
+		cairo_text_extents(cr, initial, &extents);
+		cairo_move_to(cr, alloc.x + 4 + 14 - extents.width / 2,
+			      alloc.y + 4 + 14 + extents.height / 2);
+		cairo_show_text(cr, initial);
+	}
+	cairo_set_source_rgb(cr, 1, 1, 1);
+	cairo_set_font_size(cr, 13);
+	cairo_text_extents(cr, "Ag", &extents);
+	cairo_move_to(cr, alloc.x + 44,
+		      alloc.y + alloc.height / 2 + extents.height / 2);
+	cairo_show_text(cr, item->name);
+	cairo_destroy(cr);
+}
+
+static int
+panel_menu_item_enter_handler(struct widget *widget, struct input *input,
+			      float x, float y, void *data)
+{
+	struct panel_menu_item *item = data;
+
+	item->focused = 1;
+	widget_schedule_redraw(widget);
+	return CURSOR_LEFT_PTR;
+}
+
+static void
+panel_menu_item_leave_handler(struct widget *widget, struct input *input,
+			      void *data)
+{
+	struct panel_menu_item *item = data;
+
+	item->focused = 0;
+	widget_schedule_redraw(widget);
+}
+
+static void
+panel_menu_item_button_handler(struct widget *widget, struct input *input,
+			       uint32_t time, uint32_t button,
+			       enum wl_pointer_button_state state, void *data)
+{
+	struct panel_menu_item *item = data;
+
+	if (state != WL_POINTER_BUTTON_STATE_RELEASED)
+		return;
+	panel_menu_item_activate(item);
+	panel_set_menu_open(item->panel, 0);
+}
+
+static void
+panel_build_menu(struct panel *panel)
+{
+	size_t i;
+
+	for (i = 0; i < ARRAY_LENGTH(synveil_apps); i++) {
+		const struct synveil_app *app = &synveil_apps[i];
+		struct panel_menu_item *item;
+
+		if (!synveil_app_available(app))
+			continue;
+		item = xzalloc(sizeof *item);
+		item->panel = panel;
+		item->name = app->name;
+		item->path = app->path;
+		item->arg = app->arg;
+		item->app_id = app->app_id;
+		item->widget = widget_add_widget(panel->widget, item);
+		wl_list_insert(panel->menu_list.prev, &item->link);
+		widget_set_redraw_handler(item->widget,
+					  panel_menu_item_redraw_handler);
+		widget_set_enter_handler(item->widget,
+					 panel_menu_item_enter_handler);
+		widget_set_leave_handler(item->widget,
+					 panel_menu_item_leave_handler);
+		widget_set_button_handler(item->widget,
+					  panel_menu_item_button_handler);
+	}
+}
+
+/* ---- synveil_shell_panel listener ---- */
+
+static void
+synveil_panels_sync(struct desktop *desktop)
+{
+	struct output *output;
+
+	wl_list_for_each(output, &desktop->outputs, link)
+		if (output->panel)
+			panel_sync_tasks(output->panel, desktop);
+}
+
+static void
+synveil_panels_redraw_task(struct desktop *desktop, uint32_t id)
+{
+	struct output *output;
+	struct panel_task *ptask;
+
+	wl_list_for_each(output, &desktop->outputs, link) {
+		if (!output->panel)
+			continue;
+		wl_list_for_each(ptask, &output->panel->task_list, link)
+			if (ptask->task->id == id)
+				widget_schedule_redraw(ptask->widget);
+		widget_schedule_redraw(output->panel->widget);
+	}
+}
+
+static struct synveil_task *
+synveil_find_task(struct desktop *desktop, uint32_t id)
+{
+	struct synveil_task *task;
+
+	wl_list_for_each(task, &desktop->synveil_tasks, link)
+		if (task->id == id)
+			return task;
+	return NULL;
+}
+
+static void
+synveil_handle_window_added(void *data, struct synveil_shell_panel *proto,
+			    uint32_t id, const char *app_id,
+			    const char *title)
+{
+	struct desktop *desktop = data;
+	struct synveil_task *task;
+
+	if (synveil_find_task(desktop, id))
+		return;
+	task = xzalloc(sizeof *task);
+	task->id = id;
+	task->app_id = xstrdup(app_id ? app_id : "");
+	task->title = xstrdup(title ? title : "");
+	task->state = 0;
+	wl_list_insert(desktop->synveil_tasks.prev, &task->link);
+	synveil_panels_sync(desktop);
+}
+
+static void
+synveil_handle_window_removed(void *data, struct synveil_shell_panel *proto,
+			      uint32_t id)
+{
+	struct desktop *desktop = data;
+	struct synveil_task *task = synveil_find_task(desktop, id);
+
+	if (!task)
+		return;
+	wl_list_remove(&task->link);
+	free(task->app_id);
+	free(task->title);
+	free(task);
+	synveil_panels_sync(desktop);
+}
+
+static void
+synveil_handle_window_properties(void *data,
+				 struct synveil_shell_panel *proto,
+				 uint32_t id, const char *app_id,
+				 const char *title)
+{
+	struct desktop *desktop = data;
+	struct synveil_task *task = synveil_find_task(desktop, id);
+	struct output *output;
+	struct rectangle alloc;
+
+	if (!task)
+		return;
+	free(task->app_id);
+	task->app_id = xstrdup(app_id ? app_id : "");
+	free(task->title);
+	task->title = xstrdup(title ? title : "");
+	/* A title change can resize the button. */
+	wl_list_for_each(output, &desktop->outputs, link) {
+		if (!output->panel)
+			continue;
+		widget_get_allocation(output->panel->widget, &alloc);
+		if (alloc.width > 0)
+			panel_layout(output->panel, alloc.width,
+				     alloc.height);
+	}
+	synveil_panels_redraw_task(desktop, id);
+}
+
+static void
+synveil_handle_window_state(void *data, struct synveil_shell_panel *proto,
+			    uint32_t id, uint32_t state)
+{
+	struct desktop *desktop = data;
+	struct synveil_task *task = synveil_find_task(desktop, id);
+
+	if (!task)
+		return;
+	task->state = state;
+	synveil_panels_redraw_task(desktop, id);
+}
+
+static void
+synveil_handle_menu_dismiss(void *data, struct synveil_shell_panel *proto)
+{
+	struct desktop *desktop = data;
+	struct output *output;
+
+	wl_list_for_each(output, &desktop->outputs, link)
+		if (output->panel && output->panel->menu_open)
+			panel_set_menu_open(output->panel, 0);
+}
+
+static const struct synveil_shell_panel_listener synveil_panel_listener = {
+	.window_added = synveil_handle_window_added,
+	.window_removed = synveil_handle_window_removed,
+	.window_properties_changed = synveil_handle_window_properties,
+	.window_state_changed = synveil_handle_window_state,
+	.menu_dismiss = synveil_handle_menu_dismiss,
+};
