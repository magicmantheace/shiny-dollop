+static int
+synveil_app_available(const struct synveil_app *app)
+{
+	if (app->marker && access(app->marker, F_OK) != 0)
+		return 0;
+	return access(app->path, X_OK) == 0;
+}
+
+static int
+sv_menu_height(struct panel *panel)
+{
+	struct panel_menu_item *item;
+	int n = 0;
+
+	wl_list_for_each(item, &panel->menu_list, link)
+		n++;
+	return 16 + n * SV_MENU_ITEM_H;
+}
+
+static struct desktop *
+panel_get_desktop(struct panel *panel)
+{
+	return display_get_user_data(window_get_display(panel->window));
+}
+
+static void
+panel_layout(struct panel *panel, int width, int height)
+{
+	struct panel_launcher *launcher;
+	struct panel_task *ptask;
+	struct panel_menu_item *item;
+	int strip_y = height - SV_STRIP_H;
+	int x;
+	int i;
+
+	widget_set_allocation(panel->start_widget, 6, strip_y + 5, 38, 38);
+	x = 6 + 38 + 6;
+
+	wl_list_for_each(launcher, &panel->launcher_list, link) {
+		widget_set_allocation(launcher->widget, x, strip_y,
+				      SV_STRIP_H, SV_STRIP_H);
+		x += SV_STRIP_H + 2;
+	}
+	if (!wl_list_empty(&panel->launcher_list))
+		x += 6;
+
+	wl_list_for_each(ptask, &panel->task_list, link) {
+		const char *title = ptask->task->title;
+		int w = (int) sv_text_width(title ? title : "", 12) + 28;
+
+		if (w < 84)
+			w = 84;
+		if (w > 176)
+			w = 176;
+		widget_set_allocation(ptask->widget, x, strip_y + 6, w, 36);
+		x += w + 4;
+	}
+
+	if (panel->clock) {
+		int w = panel->clock_format == CLOCK_FORMAT_SECONDS ?
+			170 : 150;
+
+		widget_set_allocation(panel->clock->widget, width - w,
+				      strip_y, w, SV_STRIP_H);
+	}
+
+	i = 0;
+	wl_list_for_each(item, &panel->menu_list, link) {
+		if (panel->menu_open)
+			widget_set_allocation(item->widget, 12,
+					      12 + i * SV_MENU_ITEM_H,
+					      SV_MENU_WIDTH - 24,
+					      SV_MENU_ITEM_H - 4);
+		else
+			widget_set_allocation(item->widget, 0, 0, 0, 0);
+		i++;
+	}
+}
+
+static void
+panel_set_menu_open(struct panel *panel, int open)
+{
+	struct desktop *desktop = panel_get_desktop(panel);
+	struct rectangle alloc;
+
+	if (panel->menu_open == open)
+		return;
+	panel->menu_open = open;
+	if (desktop->synveil_panel)
+		synveil_shell_panel_set_menu_open(desktop->synveil_panel,
+						  open);
+	widget_get_allocation(panel->widget, &alloc);
+	if (alloc.width > 0)
+		window_schedule_resize(panel->window, alloc.width,
+				       open ? SV_STRIP_H +
+					      sv_menu_height(panel)
+					    : SV_STRIP_H);
+	widget_schedule_redraw(panel->widget);
+	widget_schedule_redraw(panel->start_widget);
+}
