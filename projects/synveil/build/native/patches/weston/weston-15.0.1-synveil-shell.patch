+/* ---- Start button ---- */
+
+static void
+start_redraw_handler(struct widget *widget, void *data)
+{
+	struct panel *panel = data;
+	cairo_t *cr;
+	struct rectangle alloc;
+	double gx, gy;
+
+	widget_get_allocation(widget, &alloc);
+	if (alloc.width == 0)
+		return;
+
+	cr = widget_cairo_create(panel->widget);
+	if (panel->menu_open || panel->start_focused) {
+		sv_rounded_rect(cr, alloc.x, alloc.y, alloc.width,
+				alloc.height, 4);
+		sv_set_rgb(cr, SV_COLOR_SURFACE_HI);
+		cairo_fill(cr);
+	}
+	/* Original four-pane mark in the accent token. */
+	sv_set_rgb(cr, SV_COLOR_ACCENT);
+	gx = alloc.x + alloc.width / 2.0 - 9;
+	gy = alloc.y + alloc.height / 2.0 - 9;
+	sv_rounded_rect(cr, gx, gy, 8, 8, 2);
+	cairo_fill(cr);
+	sv_rounded_rect(cr, gx + 10, gy, 8, 8, 2);
+	cairo_fill(cr);
+	sv_rounded_rect(cr, gx, gy + 10, 8, 8, 2);
+	cairo_fill(cr);
+	sv_rounded_rect(cr, gx + 10, gy + 10, 8, 8, 2);
+	cairo_fill(cr);
+	cairo_destroy(cr);
+}
+
