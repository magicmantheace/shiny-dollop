+/* Synveil shell panel protocol (ADR 0025).
+ *
+ * The shell publishes its toplevel window list to its own
+ * helper client (the panel) over the private synveil_shell_panel
+ * interface, and the helper asks the shell to activate or
+ * minimize published windows. Requests are honored only from
+ * the resource bound by the shell's own launched client
+ * (shell->child.client); other binders get an inert object.
+ * Transient surfaces (those with a parent) are not published:
+ * a taskbar lists windows, not dialogs. */
+
+static void set_minimized(struct weston_surface *surface);
+
+static bool
+synveil_surface_is_minimized(struct shell_surface *shsurf)
+{
+	if (!shsurf->view)
+		return false;
+	return shsurf->view->layer_link.layer ==
+		&shsurf->shell->minimized_layer;
+}
+
+static uint32_t
+synveil_surface_state(struct shell_surface *shsurf)
+{
+	uint32_t state = 0;
+
+	if (shsurf->focus_count > 0)
+		state |= SYNVEIL_SHELL_PANEL_WINDOW_STATE_ACTIVATED;
+	if (synveil_surface_is_minimized(shsurf))
+		state |= SYNVEIL_SHELL_PANEL_WINDOW_STATE_MINIMIZED;
+	return state;
+}
+
+static void
+synveil_panel_broadcast_state(struct shell_surface *shsurf)
+{
+	struct desktop_shell *shell = shsurf->shell;
+	uint32_t state = synveil_surface_state(shsurf);
+
+	if (state == shsurf->synveil_state)
+		return;
+	shsurf->synveil_state = state;
+	if (shell->synveil_panel_resource && shsurf->synveil_id != 0)
+		synveil_shell_panel_send_window_state_changed(
+			shell->synveil_panel_resource, shsurf->synveil_id,
+			state);
+}
+
+/* Refresh the stored app id/title from the desktop surface.
+ * Returns true when either changed. */
+static bool
+synveil_refresh_properties(struct shell_surface *shsurf)
+{
+	const char *app_id =
+		weston_desktop_surface_get_app_id(shsurf->desktop_surface);
+	const char *title =
+		weston_desktop_surface_get_title(shsurf->desktop_surface);
+	bool changed = false;
+
+	if ((app_id == NULL) != (shsurf->synveil_app_id == NULL) ||
+	    (app_id && shsurf->synveil_app_id &&
+	     strcmp(app_id, shsurf->synveil_app_id) != 0)) {
+		free(shsurf->synveil_app_id);
+		shsurf->synveil_app_id = app_id ? strdup(app_id) : NULL;
+		changed = true;
+	}
+	if ((title == NULL) != (shsurf->synveil_title == NULL) ||
+	    (title && shsurf->synveil_title &&
+	     strcmp(title, shsurf->synveil_title) != 0)) {
+		free(shsurf->synveil_title);
+		shsurf->synveil_title = title ? strdup(title) : NULL;
+		changed = true;
+	}
+	return changed;
+}
+
+static void
+synveil_panel_broadcast_properties(struct shell_surface *shsurf)
+{
+	struct desktop_shell *shell = shsurf->shell;
+
+	if (!synveil_refresh_properties(shsurf))
+		return;
+	if (shell->synveil_panel_resource && shsurf->synveil_id != 0)
+		synveil_shell_panel_send_window_properties_changed(
+			shell->synveil_panel_resource, shsurf->synveil_id,
+			shsurf->synveil_app_id ? shsurf->synveil_app_id : "",
+			shsurf->synveil_title ? shsurf->synveil_title : "");
+}
+
+static void
+synveil_panel_publish(struct shell_surface *shsurf)
+{
+	struct desktop_shell *shell = shsurf->shell;
+
+	if (shsurf->synveil_id != 0)
+		return;
+	if (weston_desktop_surface_get_parent(shsurf->desktop_surface))
+		return;
+
+	shsurf->synveil_id = shell->synveil_next_id++;
+	if (shsurf->synveil_id == 0)
+		shsurf->synveil_id = shell->synveil_next_id++;
+	synveil_refresh_properties(shsurf);
+	shsurf->synveil_state = synveil_surface_state(shsurf);
+	if (shell->synveil_panel_resource) {
+		synveil_shell_panel_send_window_added(
+			shell->synveil_panel_resource, shsurf->synveil_id,
+			shsurf->synveil_app_id ? shsurf->synveil_app_id : "",
+			shsurf->synveil_title ? shsurf->synveil_title : "");
+		synveil_shell_panel_send_window_state_changed(
+			shell->synveil_panel_resource, shsurf->synveil_id,
+			shsurf->synveil_state);
+	}
+}
+
+static void
+synveil_panel_unpublish(struct shell_surface *shsurf)
+{
+	struct desktop_shell *shell = shsurf->shell;
+
+	if (shsurf->synveil_id == 0)
+		return;
+	if (shell->synveil_panel_resource)
+		synveil_shell_panel_send_window_removed(
+			shell->synveil_panel_resource, shsurf->synveil_id);
+	shsurf->synveil_id = 0;
+	free(shsurf->synveil_app_id);
+	shsurf->synveil_app_id = NULL;
+	free(shsurf->synveil_title);
+	shsurf->synveil_title = NULL;
+	shsurf->synveil_state = 0;
+}
+
+static struct shell_surface *
+synveil_find_surface(struct desktop_shell *shell, uint32_t id)
+{
+	struct shell_surface *shsurf;
+
+	if (id == 0)
+		return NULL;
+	wl_list_for_each(shsurf, &shell->shsurf_list, link)
+		if (shsurf->synveil_id == id)
+			return shsurf;
+	return NULL;
+}
+
+static void
+synveil_panel_activate_window(struct wl_client *client,
+			      struct wl_resource *resource, uint32_t id)
+{
+	struct desktop_shell *shell = wl_resource_get_user_data(resource);
+	struct shell_surface *shsurf;
+	struct weston_seat *seat;
+
+	if (resource != shell->synveil_panel_resource)
+		return;
+	shsurf = synveil_find_surface(shell, id);
+	if (!shsurf || !shsurf->view)
+		return;
+	if (wl_list_empty(&shell->compositor->seat_list))
+		return;
+	seat = wl_container_of(shell->compositor->seat_list.next,
+			       seat, link);
+	activate(shell, shsurf->view, seat,
+		 WESTON_ACTIVATE_FLAG_CONFIGURE);
+	synveil_panel_broadcast_state(shsurf);
+}
+
+static void
+synveil_panel_minimize_window(struct wl_client *client,
+			      struct wl_resource *resource, uint32_t id)
+{
+	struct desktop_shell *shell = wl_resource_get_user_data(resource);
+	struct shell_surface *shsurf;
+	struct weston_surface *surface;
+
+	if (resource != shell->synveil_panel_resource)
+		return;
+	shsurf = synveil_find_surface(shell, id);
+	if (!shsurf)
+		return;
+	surface = weston_desktop_surface_get_surface(
+		shsurf->desktop_surface);
+	set_minimized(surface);
+}
+
+static void
+synveil_panel_set_menu_open(struct wl_client *client,
+			    struct wl_resource *resource, uint32_t open)
+{
+	struct desktop_shell *shell = wl_resource_get_user_data(resource);
+
+	if (resource != shell->synveil_panel_resource)
+		return;
+	shell->synveil_menu_open = open != 0;
+}
+
+static const struct synveil_shell_panel_interface
+synveil_panel_interface = {
+	.activate_window = synveil_panel_activate_window,
+	.minimize_window = synveil_panel_minimize_window,
+	.set_menu_open = synveil_panel_set_menu_open,
+};
+
+static void
+synveil_panel_resource_destroy(struct wl_resource *resource)
+{
+	struct desktop_shell *shell = wl_resource_get_user_data(resource);
+
+	if (shell->synveil_panel_resource == resource) {
+		shell->synveil_panel_resource = NULL;
+		shell->synveil_menu_open = false;
+	}
+}
+
+static void
+bind_synveil_panel(struct wl_client *client, void *data,
+		   uint32_t version, uint32_t id)
+{
+	struct desktop_shell *shell = data;
+	struct wl_resource *resource;
+	struct shell_surface *shsurf;
+
+	resource = wl_resource_create(client,
+				      &synveil_shell_panel_interface,
+				      version, id);
+	if (!resource) {
+		wl_client_post_no_memory(client);
+		return;
+	}
+	wl_resource_set_implementation(resource, &synveil_panel_interface,
+				       shell, synveil_panel_resource_destroy);
+
+	if (client != shell->child.client)
+		return;
+
+	/* The shell's own helper: make it authoritative and bring
+	 * it up to date with the windows that already exist. */
+	shell->synveil_panel_resource = resource;
+	wl_list_for_each(shsurf, &shell->shsurf_list, link) {
+		if (shsurf->synveil_id == 0)
+			continue;
+		synveil_shell_panel_send_window_added(
+			resource, shsurf->synveil_id,
+			shsurf->synveil_app_id ? shsurf->synveil_app_id : "",
+			shsurf->synveil_title ? shsurf->synveil_title : "");
+		synveil_shell_panel_send_window_state_changed(
+			resource, shsurf->synveil_id,
+			shsurf->synveil_state);
+	}
+}
