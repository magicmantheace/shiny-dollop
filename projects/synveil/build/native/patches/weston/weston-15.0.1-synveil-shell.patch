+/* Synveil tray status (shell polish pass): the panel's status
+ * area shows the machine's real network link state (read from
+ * /sys/class/net) and the A/B update state (read from the update
+ * agent's typed socket, synveil.ab-agent/v1 — the same read-only
+ * status request the updates window makes). Refreshed by a
+ * periodic timer; the agent query is a non-blocking state
+ * machine so the panel never stalls on it. The helper stays an
+ * unprivileged client: sysfs is world-readable, and the agent
+ * socket is the session's own group-writable status surface. */
+struct sv_tray {
+	int net_present;
+	int net_up;
+	int update_known;
+	int update_pending;
+	struct toytimer timer;
+	int timer_live;
+	int query_fd;
+	struct task query_task;
+	int query_sent;
+	size_t query_len;
+	uint64_t query_deadline_ms;
+	uint64_t last_query_ms;
+	char query_buf[16384];
+};
