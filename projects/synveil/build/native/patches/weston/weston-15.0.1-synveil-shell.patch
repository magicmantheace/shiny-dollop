+static void
+panel_layout(struct panel *panel, int width, int height)
+{
+	struct panel_launcher *launcher;
+	struct panel_task *ptask;
+	struct panel_menu_item *item;
+	int strip_y = height - SV_STRIP_H;
+	int x;
+	int i;
+
+	widget_set_allocation(panel->start_widget, 6, strip_y + 5, 38, 38);
+	x = 6 + 38 + 6;
+
+	wl_list_for_each(launcher, &panel->launcher_list, link) {
+		widget_set_allocation(launcher->widget, x, strip_y,
+				      SV_STRIP_H, SV_STRIP_H);
+		x += SV_STRIP_H + 2;
+	}
+	if (!wl_list_empty(&panel->launcher_list))
+		x += 6;
+
+	wl_list_for_each(ptask, &panel->task_list, link) {
+		const char *title = ptask->task->title;
+		int w = (int) sv_text_width(title ? title : "", 12) + 50;
+
+		if (w < 106)
+			w = 106;
+		if (w > 198)
+			w = 198;
+		widget_set_allocation(ptask->widget, x, strip_y + 6, w, 36);
+		x += w + 4;
+	}
+
+	{
+		struct desktop *desktop = panel_get_desktop(panel);
+		int clock_w = 0;
+		int tray_right, upd_w;
+
+		if (panel->clock) {
+			clock_w = panel->clock_format ==
+				CLOCK_FORMAT_SECONDS ? 170 : 150;
+			widget_set_allocation(panel->clock->widget,
+					      width - clock_w, strip_y,
+					      clock_w, SV_STRIP_H);
+		}
+		/* Tray, right to left from the clock: update
+		 * state (only while the agent has answered —
+		 * an unanswered updater is not drawn at all),
+		 * then network link state. */
+		tray_right = width - clock_w - (clock_w ? 4 : 8);
+		upd_w = desktop->sv_tray.update_known ? 26 : 0;
+		if (panel->tray_update_widget)
+			widget_set_allocation(panel->tray_update_widget,
+					      tray_right - upd_w, strip_y,
+					      upd_w, SV_STRIP_H);
+		if (panel->tray_net_widget)
+			widget_set_allocation(panel->tray_net_widget,
+					      tray_right - upd_w - 26,
+					      strip_y, 26, SV_STRIP_H);
+	}
+
+	i = 0;
+	wl_list_for_each(item, &panel->menu_list, link) {
+		if (panel->menu_open)
+			widget_set_allocation(item->widget, 12,
+					      12 + i * SV_MENU_ITEM_H,
+					      SV_MENU_WIDTH - 24,
+					      SV_MENU_ITEM_H - 4);
+		else
+			widget_set_allocation(item->widget, 0, 0, 0, 0);
+		i++;
+	}
+}
+
+static void
+sv_menu_redraw_all(struct panel *panel)
+{
+	struct panel_menu_item *item;
+
+	widget_schedule_redraw(panel->widget);
+	widget_schedule_redraw(panel->start_widget);
+	wl_list_for_each(item, &panel->menu_list, link)
+		widget_schedule_redraw(item->widget);
+}
+
+static void
+sv_menu_close_finalize(struct panel *panel)
+{
+	struct desktop *desktop = panel_get_desktop(panel);
+	struct rectangle alloc;
+
+	panel->menu_open = 0;
+	panel->menu_closing = 0;
+	panel->menu_p = 0;
+	if (desktop->synveil_panel)
+		synveil_shell_panel_set_menu_open(desktop->synveil_panel,
+						  0);
+	widget_get_allocation(panel->widget, &alloc);
+	if (alloc.width > 0)
+		window_schedule_resize(panel->window, alloc.width,
+				       SV_STRIP_H);
+	sv_menu_redraw_all(panel);
+}
+
+static void
+sv_menu_anim_cb(struct toytimer *tt)
+{
+	struct panel *panel = container_of(tt, struct panel, menu_timer);
+	uint64_t now = sv_now_ms();
+	double t = (double) (now - panel->menu_anim_start_ms) / 200.0;
+
+	if (t >= 1.0) {
+		panel->menu_p = panel->menu_anim_to;
+		panel->menu_timer_live = 0;
+		if (panel->menu_closing)
+			sv_menu_close_finalize(panel);
+		else
+			sv_menu_redraw_all(panel);
+		return;
+	}
+	panel->menu_p = panel->menu_anim_from +
+		(panel->menu_anim_to - panel->menu_anim_from) *
+		sv_ease_out_cubic(t);
+	sv_menu_redraw_all(panel);
+	toytimer_arm_once_usec(&panel->menu_timer, 16000);
+}
+
+static void
+sv_menu_anim_start(struct panel *panel, double to)
+{
+	panel->menu_anim_from = panel->menu_p;
+	panel->menu_anim_to = to;
+	panel->menu_anim_start_ms = sv_now_ms();
+	if (!panel->menu_timer_live) {
+		panel->menu_timer_live = 1;
+		toytimer_arm_once_usec(&panel->menu_timer, 1000);
+	}
+}
+
+/* Open or close the Start menu with the UI_DESIGN slide:
+ * 200 ms ease-out, driven by the panel's frame timer. Opening
+ * resizes the panel surface immediately (input is never
+ * delayed by the animation; only the drawing moves), closing
+ * lands its resize and protocol transition when the slide
+ * completes, in sv_menu_close_finalize. */
+static void
+panel_set_menu_open(struct panel *panel, int open)
+{
+	struct desktop *desktop = panel_get_desktop(panel);
+	struct rectangle alloc;
+
+	if (open) {
+		if (panel->menu_open && !panel->menu_closing)
+			return;
+		if (!panel->menu_open) {
+			panel->menu_open = 1;
+			if (desktop->synveil_panel)
+				synveil_shell_panel_set_menu_open(
+					desktop->synveil_panel, 1);
+			widget_get_allocation(panel->widget, &alloc);
+			if (alloc.width > 0)
+				window_schedule_resize(
+					panel->window, alloc.width,
+					SV_STRIP_H + sv_menu_height(panel));
+		}
+		panel->menu_closing = 0;
+		sv_menu_anim_start(panel, 1.0);
+	} else {
+		if (!panel->menu_open || panel->menu_closing)
+			return;
+		panel->menu_closing = 1;
+		sv_menu_anim_start(panel, 0.0);
+	}
+	widget_schedule_redraw(panel->widget);
+	widget_schedule_redraw(panel->start_widget);
+}
+
+/* ---- Start button ---- */
+
+static void
+start_redraw_handler(struct widget *widget, void *data)
+{
+	struct panel *panel = data;
+	cairo_t *cr;
+	struct rectangle alloc;
+	double gx, gy;
+
+	widget_get_allocation(widget, &alloc);
+	if (alloc.width == 0)
+		return;
+
+	cr = widget_cairo_create(panel->widget);
+	if (panel->start_pressed) {
+		sv_rounded_rect(cr, alloc.x, alloc.y, alloc.width,
+				alloc.height, 4);
+		sv_set_rgb(cr, SV_COLOR_ACCENT_PRESSED);
+		cairo_fill(cr);
+	} else if (panel->menu_open || panel->start_focused) {
+		sv_rounded_rect(cr, alloc.x, alloc.y, alloc.width,
+				alloc.height, 4);
+		sv_set_rgb(cr, SV_COLOR_SURFACE_HI);
+		cairo_fill(cr);
+	}
+	/* Original four-pane mark in the accent token. */
+	sv_set_rgb(cr, SV_COLOR_ACCENT);
+	gx = alloc.x + alloc.width / 2.0 - 9;
+	gy = alloc.y + alloc.height / 2.0 - 9;
+	sv_rounded_rect(cr, gx, gy, 8, 8, 2);
+	cairo_fill(cr);
+	sv_rounded_rect(cr, gx + 10, gy, 8, 8, 2);
+	cairo_fill(cr);
+	sv_rounded_rect(cr, gx, gy + 10, 8, 8, 2);
+	cairo_fill(cr);
+	sv_rounded_rect(cr, gx + 10, gy + 10, 8, 8, 2);
+	cairo_fill(cr);
+	cairo_destroy(cr);
+}
+
+static int
+start_enter_handler(struct widget *widget, struct input *input,
+		    float x, float y, void *data)
+{
+	struct panel *panel = data;
+
+	panel->start_focused = 1;
+	widget_schedule_redraw(widget);
+	return CURSOR_LEFT_PTR;
+}
+
+static void
+start_leave_handler(struct widget *widget, struct input *input,
+		    void *data)
+{
+	struct panel *panel = data;
+
+	panel->start_focused = 0;
+	panel->start_pressed = 0;
+	widget_schedule_redraw(widget);
+}
+
+static void
+start_button_handler(struct widget *widget, struct input *input,
+		     uint32_t time, uint32_t button,
+		     enum wl_pointer_button_state state, void *data)
+{
+	struct panel *panel = data;
+	int want;
+
+	if (button != BTN_LEFT)
+		return;
+	if (state == WL_POINTER_BUTTON_STATE_PRESSED) {
+		panel->start_pressed = 1;
+		widget_schedule_redraw(widget);
+		return;
+	}
+	panel->start_pressed = 0;
+	/* A re-press mid close-slide re-opens. */
+	want = (!panel->menu_open || panel->menu_closing) ? 1 : 0;
+	panel_set_menu_open(panel, want);
+}
+
+static int
+start_motion_handler(struct widget *widget, struct input *input,
+		     uint32_t time, float x, float y, void *data)
+{
+	widget_set_tooltip(widget, "Start", x, y);
+	return CURSOR_LEFT_PTR;
+}
+
+/* ---- Task buttons ---- */
+
+static int
+sv_icon_for_task(struct synveil_task *task)
+{
+	const char *app_id = task->app_id;
+	const char *title = task->title;
+
+	if (app_id) {
+		if (strstr(app_id, "files"))
+			return SV_ICON_FILES;
+		if (strstr(app_id, "update"))
+			return SV_ICON_UPDATES;
+		if (strstr(app_id, "first-window"))
+			return SV_ICON_DEMO;
+		if (strstr(app_id, "terminal"))
+			return SV_ICON_TERMINAL;
+		if (strstr(app_id, "chromium") ||
+		    strstr(app_id, "browser"))
+			return SV_ICON_BROWSER;
+	}
+	if (title && strcmp(title, "Terminal") == 0)
+		return SV_ICON_TERMINAL;
+	return SV_ICON_WINDOW;
+}
+
+static void
+panel_task_redraw_handler(struct widget *widget, void *data)
+{
+	struct panel_task *ptask = data;
+	struct synveil_task *task = ptask->task;
+	cairo_t *cr;
+	struct rectangle alloc;
+	const char *title = task->title ? task->title : "";
+	int activated = (task->state &
+			 SYNVEIL_SHELL_PANEL_WINDOW_STATE_ACTIVATED) != 0;
+	int minimized = (task->state &
+			 SYNVEIL_SHELL_PANEL_WINDOW_STATE_MINIMIZED) != 0;
+	cairo_text_extents_t extents;
+
+	widget_get_allocation(widget, &alloc);
+	if (alloc.width == 0)
+		return;
+
+	cr = widget_cairo_create(ptask->panel->widget);
+	if (ptask->pressed) {
+		sv_rounded_rect(cr, alloc.x, alloc.y, alloc.width,
+				alloc.height, 4);
+		sv_set_rgb(cr, SV_COLOR_ACCENT_PRESSED);
+		cairo_fill(cr);
+	} else if (activated || ptask->focused) {
+		sv_rounded_rect(cr, alloc.x, alloc.y, alloc.width,
+				alloc.height, 4);
+		sv_set_rgb(cr, SV_COLOR_SURFACE_HI);
+		cairo_fill(cr);
+	}
+	if (activated) {
+		sv_set_rgb(cr, SV_COLOR_ACCENT);
+		cairo_rectangle(cr, alloc.x + alloc.width / 2 - 12,
+				alloc.y + alloc.height - 3, 24, 3);
+		cairo_fill(cr);
+	}
+	sv_draw_icon(cr, sv_icon_for_task(task), alloc.x + 8,
+		     alloc.y + 10, 16);
+	cairo_set_font_size(cr, 12);
+	cairo_text_extents(cr, "Ag", &extents);
+	if (minimized)
+		cairo_set_source_rgb(cr, 0x8A / 255.0, 0x8A / 255.0,
+				     0x8A / 255.0);
+	else if (activated)
+		cairo_set_source_rgb(cr, 1, 1, 1);
+	else
+		cairo_set_source_rgb(cr, 0xC8 / 255.0, 0xC8 / 255.0,
+				     0xC8 / 255.0);
+	cairo_move_to(cr, alloc.x + 30,
+		      alloc.y + alloc.height / 2 + extents.height / 2 - 1);
+	sv_show_text_clipped(cr, title, 12, alloc.width - 38);
+	cairo_destroy(cr);
+}
+
+static int
+panel_task_enter_handler(struct widget *widget, struct input *input,
+			 float x, float y, void *data)
+{
+	struct panel_task *ptask = data;
+
+	ptask->focused = 1;
+	widget_schedule_redraw(widget);
+	return CURSOR_LEFT_PTR;
+}
+
+static void
+panel_task_leave_handler(struct widget *widget, struct input *input,
+			 void *data)
+{
+	struct panel_task *ptask = data;
+
+	ptask->focused = 0;
+	ptask->pressed = 0;
+	widget_destroy_tooltip(widget);
+	widget_schedule_redraw(widget);
+}
+
+static int
+panel_task_motion_handler(struct widget *widget, struct input *input,
+			  uint32_t time, float x, float y, void *data)
+{
+	struct panel_task *ptask = data;
+
+	if (ptask->task->title && ptask->task->title[0])
+		widget_set_tooltip(widget, ptask->task->title, x, y);
+
+	return CURSOR_LEFT_PTR;
+}
+
+static void
+panel_task_button_handler(struct widget *widget, struct input *input,
+			  uint32_t time, uint32_t button,
+			  enum wl_pointer_button_state state, void *data)
+{
+	struct panel_task *ptask = data;
+	struct desktop *desktop = panel_get_desktop(ptask->panel);
+	struct synveil_task *task = ptask->task;
+	int activated = (task->state &
+			 SYNVEIL_SHELL_PANEL_WINDOW_STATE_ACTIVATED) != 0;
+	int minimized = (task->state &
+			 SYNVEIL_SHELL_PANEL_WINDOW_STATE_MINIMIZED) != 0;
+
+	if (state == WL_POINTER_BUTTON_STATE_PRESSED) {
+		if (button == BTN_LEFT) {
+			ptask->pressed = 1;
+			widget_schedule_redraw(widget);
+		}
+		return;
+	}
+	ptask->pressed = 0;
+	widget_schedule_redraw(widget);
+	if (!desktop->synveil_panel)
+		return;
+	if (ptask->panel->menu_open)
+		panel_set_menu_open(ptask->panel, 0);
+	if (activated && !minimized)
+		synveil_shell_panel_minimize_window(desktop->synveil_panel,
+						    task->id);
+	else
+		synveil_shell_panel_activate_window(desktop->synveil_panel,
+						    task->id);
+}
+
+static void
+panel_task_destroy(struct panel_task *ptask)
+{
+	widget_destroy(ptask->widget);
+	wl_list_remove(&ptask->link);
+	free(ptask);
+}
+
+static void
+panel_task_create(struct panel *panel, struct synveil_task *task)
+{
+	struct panel_task *ptask = xzalloc(sizeof *ptask);
+
+	ptask->panel = panel;
+	ptask->task = task;
+	ptask->widget = widget_add_widget(panel->widget, ptask);
+	wl_list_insert(panel->task_list.prev, &ptask->link);
+	widget_set_redraw_handler(ptask->widget, panel_task_redraw_handler);
+	widget_set_enter_handler(ptask->widget, panel_task_enter_handler);
+	widget_set_leave_handler(ptask->widget, panel_task_leave_handler);
+	widget_set_button_handler(ptask->widget, panel_task_button_handler);
+	widget_set_motion_handler(ptask->widget, panel_task_motion_handler);
+}
+
+/* Mirror the desktop's window model with this panel's widgets,
+ * then lay out and repaint. */
+static void
+panel_sync_tasks(struct panel *panel, struct desktop *desktop)
+{
+	struct panel_task *ptask, *tmp;
+	struct synveil_task *task;
+	struct rectangle alloc;
+	int found;
+
+	wl_list_for_each_safe(ptask, tmp, &panel->task_list, link) {
+		found = 0;
+		wl_list_for_each(task, &desktop->synveil_tasks, link)
+			if (task == ptask->task)
+				found = 1;
+		if (!found)
+			panel_task_destroy(ptask);
+	}
+	wl_list_for_each(task, &desktop->synveil_tasks, link) {
+		found = 0;
+		wl_list_for_each(ptask, &panel->task_list, link)
+			if (ptask->task == task)
+				found = 1;
+		if (!found)
+			panel_task_create(panel, task);
+	}
+	widget_get_allocation(panel->widget, &alloc);
+	if (alloc.width > 0)
+		panel_layout(panel, alloc.width, alloc.height);
+	widget_schedule_redraw(panel->widget);
+}
+
+/* ---- Tray / status area (shell polish pass) ----
+ *
+ * Real status only, through surfaces the unprivileged helper
+ * may already use: the network link state is the kernel's own
+ * /sys/class/net carrier flags (world-readable), and the
+ * update state comes from the A/B agent's typed socket using
+ * the same read-only "status" request the updates window
+ * makes (docs/UPDATE_GUI.md). If the agent never answers, the
+ * update slot is not drawn at all — the shell never claims a
+ * state it could not read. */
+
+#define SV_AB_AGENT_SOCKET "/run/synveil-ab/agent.sock"
+#define SV_TRAY_QUERY_EVERY_MS 8000
+#define SV_TRAY_QUERY_TIMEOUT_MS 3000
+
+static void
+sv_tray_sync_panels(struct desktop *desktop)
+{
+	struct output *output;
+	struct rectangle alloc;
+
+	wl_list_for_each(output, &desktop->outputs, link) {
+		if (!output->panel)
+			continue;
+		widget_get_allocation(output->panel->widget, &alloc);
+		if (alloc.width > 0)
+			panel_layout(output->panel, alloc.width,
+				     alloc.height);
+		if (output->panel->tray_net_widget)
+			widget_schedule_redraw(
+				output->panel->tray_net_widget);
+		if (output->panel->tray_update_widget)
+			widget_schedule_redraw(
+				output->panel->tray_update_widget);
+	}
+}
+
+static void
+sv_tray_net_poll(struct desktop *desktop)
+{
+	struct sv_tray *tray = &desktop->sv_tray;
+	DIR *dir;
+	struct dirent *ent;
+	int present = 0, up = 0;
+
+	dir = opendir("/sys/class/net");
+	if (dir) {
+		while ((ent = readdir(dir)) != NULL) {
+			char path[300];
+			FILE *f;
+			char v = 0;
+
+			if (ent->d_name[0] == '.' ||
+			    strcmp(ent->d_name, "lo") == 0)
+				continue;
+			snprintf(path, sizeof path,
+				 "/sys/class/net/%s/carrier", ent->d_name);
+			f = fopen(path, "r");
+			if (!f)
+				continue;
+			if (fread(&v, 1, 1, f) == 1) {
+				present = 1;
+				if (v == '1')
+					up = 1;
+			}
+			fclose(f);
+		}
+		closedir(dir);
+	}
+	if (present != tray->net_present || up != tray->net_up) {
+		tray->net_present = present;
+		tray->net_up = up;
+		sv_tray_sync_panels(desktop);
+	}
+}
+
+static void sv_tray_query_done(struct desktop *desktop, int ok);
+
+static void
+sv_tray_query_abort(struct desktop *desktop)
+{
+	struct sv_tray *tray = &desktop->sv_tray;
+
+	if (tray->query_fd >= 0) {
+		display_unwatch_fd(desktop->display, tray->query_fd);
+		close(tray->query_fd);
+		tray->query_fd = -1;
+	}
+}
+
+static void
+sv_tray_query_done(struct desktop *desktop, int ok)
+{
+	struct sv_tray *tray = &desktop->sv_tray;
+	const char *t, *a, *sig;
+	int pending = 0;
+
+	sv_tray_query_abort(desktop);
+	tray->last_query_ms = sv_now_ms();
+	if (!ok)
+		return;
+	/* Trust only the agent's own versioned envelope: the
+	 * schema must be synveil.ab-agent/v1 and ok must be
+	 * true before any state field is read. The status
+	 * fields keep the agent's documented key order
+	 * (docs/UPDATE_GUI.md), so targeted reads suffice —
+	 * the same approach as the updates window's facts
+	 * parsing, without a general JSON parser. */
+	if (!strstr(tray->query_buf,
+		    "\"schema\":\"synveil.ab-agent/v1\"") ||
+	    !strstr(tray->query_buf, "\"ok\":true"))
+		return;
+	if (!strstr(tray->query_buf, "\"enabled\":true"))
+		return;
+	t = strstr(tray->query_buf, "\"trial\":");
+	if (t) {
+		t += strlen("\"trial\":");
+		while (*t == ' ')
+			t++;
+		if (*t == '{')
+			pending = 1;
+	}
+	a = strstr(tray->query_buf, "\"available\":");
+	if (a) {
+		sig = strstr(a, "\"signature\":\"valid\"");
+		if (sig && sig - a < 512)
+			pending = 1;
+	}
+	if (!tray->update_known || tray->update_pending != pending) {
+		tray->update_known = 1;
+		tray->update_pending = pending;
+		sv_tray_sync_panels(desktop);
+	}
+}
+
+static void
+sv_tray_query_task_run(struct task *task, uint32_t events)
+{
+	struct desktop *desktop =
+		container_of(task, struct desktop, sv_tray.query_task);
+	struct sv_tray *tray = &desktop->sv_tray;
+	static const char request[] =
+		"{\"schema\":\"synveil.ab-agent/v1\",\"id\":\"tray\","
+		"\"action\":\"status\"}\n";
+
+	if (events & (EPOLLERR | EPOLLHUP)) {
+		sv_tray_query_done(desktop, 0);
+		return;
+	}
+	if (!tray->query_sent && (events & EPOLLOUT)) {
+		ssize_t n = send(tray->query_fd, request,
+				 sizeof(request) - 1, MSG_NOSIGNAL);
+
+		if (n < 0) {
+			if (errno == EAGAIN || errno == EWOULDBLOCK)
+				return;
+			sv_tray_query_done(desktop, 0);
+			return;
+		}
+		tray->query_sent = 1;
+	}
+	if (events & EPOLLIN) {
+		for (;;) {
+			ssize_t n;
+
+			if (tray->query_len >= sizeof(tray->query_buf) - 1)
+				break;
+			n = recv(tray->query_fd,
+				 tray->query_buf + tray->query_len,
+				 sizeof(tray->query_buf) - 1 -
+				 tray->query_len, 0);
+			if (n > 0) {
+				tray->query_len += (size_t) n;
+				tray->query_buf[tray->query_len] = '\0';
+				if (memchr(tray->query_buf, '\n',
+					   tray->query_len)) {
+					sv_tray_query_done(desktop, 1);
+					return;
+				}
+				continue;
+			}
+			if (n == 0) {
+				sv_tray_query_done(desktop,
+						   tray->query_len > 0);
+				return;
+			}
+			if (errno == EAGAIN || errno == EWOULDBLOCK)
+				return;
+			sv_tray_query_done(desktop, 0);
+			return;
+		}
+		/* A full buffer with no newline is unusable. */
+		sv_tray_query_done(desktop, 0);
+	}
+}
+
+static void
+sv_tray_query_start(struct desktop *desktop)
+{
+	struct sv_tray *tray = &desktop->sv_tray;
+	struct sockaddr_un addr;
+	int fd, flags;
+
+	fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+	if (fd < 0)
+		return;
+	flags = fcntl(fd, F_GETFL, 0);
+	if (flags >= 0)
+		fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+	memset(&addr, 0, sizeof addr);
+	addr.sun_family = AF_UNIX;
+	snprintf(addr.sun_path, sizeof addr.sun_path, "%s",
+		 SV_AB_AGENT_SOCKET);
+	if (connect(fd, (struct sockaddr *) &addr, sizeof addr) < 0 &&
+	    errno != EINPROGRESS) {
+		close(fd);
+		tray->last_query_ms = sv_now_ms();
+		return;
+	}
+	tray->query_fd = fd;
+	tray->query_sent = 0;
+	tray->query_len = 0;
+	tray->query_buf[0] = '\0';
+	tray->query_deadline_ms = sv_now_ms() + SV_TRAY_QUERY_TIMEOUT_MS;
+	tray->query_task.run = sv_tray_query_task_run;
+	display_watch_fd(desktop->display, fd,
+			 EPOLLIN | EPOLLOUT | EPOLLERR | EPOLLHUP,
+			 &tray->query_task);
+}
+
+static void
+sv_tray_timer_cb(struct toytimer *tt)
+{
+	struct desktop *desktop =
+		container_of(tt, struct desktop, sv_tray.timer);
+	struct sv_tray *tray = &desktop->sv_tray;
+
+	sv_tray_net_poll(desktop);
+	if (tray->query_fd >= 0) {
+		if (sv_now_ms() > tray->query_deadline_ms)
+			sv_tray_query_done(desktop, 0);
+	} else if (sv_now_ms() - tray->last_query_ms >=
+		   SV_TRAY_QUERY_EVERY_MS) {
+		sv_tray_query_start(desktop);
+	}
+	toytimer_arm_once_usec(&tray->timer, 1000000);
+}
+
+static void
+sv_tray_init(struct desktop *desktop)
+{
+	struct sv_tray *tray = &desktop->sv_tray;
+
+	if (tray->timer_live)
+		return;
+	tray->query_fd = -1;
+	toytimer_init(&tray->timer, CLOCK_MONOTONIC, desktop->display,
+		      sv_tray_timer_cb);
+	tray->timer_live = 1;
+	sv_tray_net_poll(desktop);
+	sv_tray_query_start(desktop);
+	toytimer_arm_once_usec(&tray->timer, 1000000);
+}
+
+static void
+tray_net_redraw_handler(struct widget *widget, void *data)
+{
+	struct panel *panel = data;
+	struct desktop *desktop = panel_get_desktop(panel);
+	cairo_t *cr;
+	struct rectangle alloc;
+	int icon;
+
+	widget_get_allocation(widget, &alloc);
+	if (alloc.width == 0)
+		return;
+	cr = widget_cairo_create(panel->widget);
+	icon = !desktop->sv_tray.net_present ? SV_ICON_NET_NONE :
+	       desktop->sv_tray.net_up ? SV_ICON_NET_UP :
+	       SV_ICON_NET_DOWN;
+	sv_draw_icon(cr, icon, alloc.x + 4, alloc.y + 15, 18);
+	cairo_destroy(cr);
+}
+
+static int
+tray_net_motion_handler(struct widget *widget, struct input *input,
+			uint32_t time, float x, float y, void *data)
+{
+	struct panel *panel = data;
+	struct desktop *desktop = panel_get_desktop(panel);
+
+	if (!desktop->sv_tray.net_present)
+		widget_set_tooltip(widget, "Network: no interface", x, y);
+	else if (desktop->sv_tray.net_up)
+		widget_set_tooltip(widget, "Network: link up", x, y);
+	else
+		widget_set_tooltip(widget, "Network: link down", x, y);
+	return CURSOR_LEFT_PTR;
+}
+
+static void
+tray_update_redraw_handler(struct widget *widget, void *data)
+{
+	struct panel *panel = data;
+	struct desktop *desktop = panel_get_desktop(panel);
+	cairo_t *cr;
+	struct rectangle alloc;
+
+	widget_get_allocation(widget, &alloc);
+	if (alloc.width == 0)
+		return;
+	cr = widget_cairo_create(panel->widget);
+	sv_draw_icon(cr,
+		     desktop->sv_tray.update_pending ?
+		     SV_ICON_UPDATE_READY : SV_ICON_UPDATE_CURRENT,
+		     alloc.x + 4, alloc.y + 15, 18);
+	cairo_destroy(cr);
+}
+
+static int
+tray_update_motion_handler(struct widget *widget, struct input *input,
+			   uint32_t time, float x, float y, void *data)
+{
+	struct panel *panel = data;
+	struct desktop *desktop = panel_get_desktop(panel);
+
+	if (desktop->sv_tray.update_pending)
+		widget_set_tooltip(widget,
+				   "Updates: an update is ready", x, y);
+	else
+		widget_set_tooltip(widget,
+				   "Updates: no update staged", x, y);
+	return CURSOR_LEFT_PTR;
+}
+
+/* ---- Start menu items ---- */
+
+static void
+panel_menu_item_activate(struct panel_menu_item *item)
+{
+	struct desktop *desktop = panel_get_desktop(item->panel);
+	struct synveil_task *task;
+	pid_t pid;
+
+	/* Focus-or-launch for the single-instance Synveil apps:
+	 * when a window with the app's id exists, the menu entry
+	 * raises it instead of starting a second copy. */
+	if (item->app_id && desktop->synveil_panel) {
+		wl_list_for_each(task, &desktop->synveil_tasks, link) {
+			if (task->app_id &&
+			    strcmp(task->app_id, item->app_id) == 0) {
+				synveil_shell_panel_activate_window(
+					desktop->synveil_panel, task->id);
+				return;
+			}
+		}
+	}
+
+	pid = fork();
+	if (pid < 0)
+		return;
+	if (pid)
+		return;
+	if (setsid() == -1)
+		exit(EXIT_FAILURE);
+	{
+		char *const argv_with_arg[] = {
+			(char *) item->path, (char *) item->arg, NULL
+		};
+		char *const argv_plain[] = { (char *) item->path, NULL };
+
+		execv(item->path, item->arg ? argv_with_arg : argv_plain);
+		fprintf(stderr, "exec '%s' failed: %s\n", item->path,
+			strerror(errno));
+		exit(1);
+	}
+}
+
+static void
+panel_menu_item_redraw_handler(struct widget *widget, void *data)
+{
+	struct panel_menu_item *item = data;
+	cairo_t *cr;
+	struct rectangle alloc;
+	cairo_text_extents_t extents;
+
+	widget_get_allocation(widget, &alloc);
+	if (alloc.width == 0)
+		return;
+
+	cr = widget_cairo_create(item->panel->widget);
+	/* The item slides with the card (sv_menu_dy); its input
+	 * position stays at the final layout. */
+	cairo_save(cr);
+	cairo_translate(cr, 0, sv_menu_dy(item->panel));
+	if (item->pressed) {
+		sv_rounded_rect(cr, alloc.x, alloc.y, alloc.width,
+				alloc.height, 4);
+		sv_set_rgb(cr, SV_COLOR_ACCENT_PRESSED);
+		cairo_fill(cr);
+	} else if (item->focused) {
+		sv_rounded_rect(cr, alloc.x, alloc.y, alloc.width,
+				alloc.height, 4);
+		sv_set_rgb(cr, SV_COLOR_SURFACE_HI);
+		cairo_fill(cr);
+	}
+	/* The app's original geometric mark (shell polish pass):
+	 * drawn primitives only, no artwork files. */
+	sv_draw_icon(cr, item->icon, alloc.x + 4, alloc.y + 4, 28);
+	cairo_set_source_rgb(cr, 1, 1, 1);
+	cairo_set_font_size(cr, 13);
+	cairo_text_extents(cr, "Ag", &extents);
+	cairo_move_to(cr, alloc.x + 44,
+		      alloc.y + alloc.height / 2 + extents.height / 2);
+	cairo_show_text(cr, item->name);
+	cairo_restore(cr);
+	cairo_destroy(cr);
+}
+
+static int
+panel_menu_item_enter_handler(struct widget *widget, struct input *input,
+			      float x, float y, void *data)
+{
+	struct panel_menu_item *item = data;
+
+	item->focused = 1;
+	widget_schedule_redraw(widget);
+	return CURSOR_LEFT_PTR;
+}
+
+static void
+panel_menu_item_leave_handler(struct widget *widget, struct input *input,
+			      void *data)
+{
+	struct panel_menu_item *item = data;
+
+	item->focused = 0;
+	item->pressed = 0;
+	widget_schedule_redraw(widget);
+}
+
+static void
+panel_menu_item_button_handler(struct widget *widget, struct input *input,
+			       uint32_t time, uint32_t button,
+			       enum wl_pointer_button_state state, void *data)
+{
+	struct panel_menu_item *item = data;
+
+	if (state == WL_POINTER_BUTTON_STATE_PRESSED) {
+		if (button == BTN_LEFT) {
+			item->pressed = 1;
+			widget_schedule_redraw(widget);
+		}
+		return;
+	}
+	item->pressed = 0;
+	widget_schedule_redraw(widget);
+	panel_menu_item_activate(item);
+	panel_set_menu_open(item->panel, 0);
+}
+
+static void
+panel_build_menu(struct panel *panel)
+{
+	size_t i;
+
+	for (i = 0; i < ARRAY_LENGTH(synveil_apps); i++) {
+		const struct synveil_app *app = &synveil_apps[i];
+		struct panel_menu_item *item;
+
+		if (!synveil_app_available(app))
+			continue;
+		item = xzalloc(sizeof *item);
+		item->panel = panel;
+		item->name = app->name;
+		item->path = app->path;
+		item->arg = app->arg;
+		item->app_id = app->app_id;
+		item->icon = app->icon;
+		item->widget = widget_add_widget(panel->widget, item);
+		wl_list_insert(panel->menu_list.prev, &item->link);
+		widget_set_redraw_handler(item->widget,
+					  panel_menu_item_redraw_handler);
+		widget_set_enter_handler(item->widget,
+					 panel_menu_item_enter_handler);
+		widget_set_leave_handler(item->widget,
+					 panel_menu_item_leave_handler);
+		widget_set_button_handler(item->widget,
+					  panel_menu_item_button_handler);
+	}
+}
+
+/* ---- synveil_shell_panel listener ---- */
+
+static void
+synveil_panels_sync(struct desktop *desktop)
+{
+	struct output *output;
+
+	wl_list_for_each(output, &desktop->outputs, link)
+		if (output->panel)
+			panel_sync_tasks(output->panel, desktop);
+}
+
+static void
+synveil_panels_redraw_task(struct desktop *desktop, uint32_t id)
+{
+	struct output *output;
+	struct panel_task *ptask;
+
+	wl_list_for_each(output, &desktop->outputs, link) {
+		if (!output->panel)
+			continue;
+		wl_list_for_each(ptask, &output->panel->task_list, link)
+			if (ptask->task->id == id)
+				widget_schedule_redraw(ptask->widget);
+		widget_schedule_redraw(output->panel->widget);
+	}
+}
+
+static struct synveil_task *
+synveil_find_task(struct desktop *desktop, uint32_t id)
+{
+	struct synveil_task *task;
+
+	wl_list_for_each(task, &desktop->synveil_tasks, link)
+		if (task->id == id)
+			return task;
+	return NULL;
+}
+
+static void
+synveil_handle_window_added(void *data, struct synveil_shell_panel *proto,
+			    uint32_t id, const char *app_id,
+			    const char *title)
+{
+	struct desktop *desktop = data;
+	struct synveil_task *task;
+
+	if (synveil_find_task(desktop, id))
+		return;
+	task = xzalloc(sizeof *task);
+	task->id = id;
+	task->app_id = xstrdup(app_id ? app_id : "");
+	task->title = xstrdup(title ? title : "");
+	task->state = 0;
+	wl_list_insert(desktop->synveil_tasks.prev, &task->link);
+	synveil_panels_sync(desktop);
+}
+
+static void
+synveil_handle_window_removed(void *data, struct synveil_shell_panel *proto,
+			      uint32_t id)
+{
+	struct desktop *desktop = data;
+	struct synveil_task *task = synveil_find_task(desktop, id);
+
+	if (!task)
+		return;
+	wl_list_remove(&task->link);
+	free(task->app_id);
+	free(task->title);
+	free(task);
+	synveil_panels_sync(desktop);
+}
+
+static void
+synveil_handle_window_properties(void *data,
+				 struct synveil_shell_panel *proto,
+				 uint32_t id, const char *app_id,
+				 const char *title)
+{
+	struct desktop *desktop = data;
+	struct synveil_task *task = synveil_find_task(desktop, id);
+	struct output *output;
+	struct rectangle alloc;
+
+	if (!task)
+		return;
+	free(task->app_id);
+	task->app_id = xstrdup(app_id ? app_id : "");
+	free(task->title);
+	task->title = xstrdup(title ? title : "");
+	/* A title change can resize the button. */
+	wl_list_for_each(output, &desktop->outputs, link) {
+		if (!output->panel)
+			continue;
+		widget_get_allocation(output->panel->widget, &alloc);
+		if (alloc.width > 0)
+			panel_layout(output->panel, alloc.width,
+				     alloc.height);
+	}
+	synveil_panels_redraw_task(desktop, id);
+}
+
+static void
+synveil_handle_window_state(void *data, struct synveil_shell_panel *proto,
+			    uint32_t id, uint32_t state)
+{
+	struct desktop *desktop = data;
+	struct synveil_task *task = synveil_find_task(desktop, id);
+
+	if (!task)
+		return;
+	task->state = state;
+	synveil_panels_redraw_task(desktop, id);
+}
+
+static void
+synveil_handle_menu_dismiss(void *data, struct synveil_shell_panel *proto)
+{
+	struct desktop *desktop = data;
+	struct output *output;
+
+	wl_list_for_each(output, &desktop->outputs, link)
+		if (output->panel && output->panel->menu_open)
+			panel_set_menu_open(output->panel, 0);
+}
+
+static const struct synveil_shell_panel_listener synveil_panel_listener = {
+	.window_added = synveil_handle_window_added,
+	.window_removed = synveil_handle_window_removed,
+	.window_properties_changed = synveil_handle_window_properties,
+	.window_state_changed = synveil_handle_window_state,
+	.menu_dismiss = synveil_handle_menu_dismiss,
+};
