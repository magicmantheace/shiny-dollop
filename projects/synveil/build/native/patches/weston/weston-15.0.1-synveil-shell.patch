+/* ---- Task buttons ---- */
+
+static void
+panel_task_redraw_handler(struct widget *widget, void *data)
+{
+	struct panel_task *ptask = data;
+	struct synveil_task *task = ptask->task;
+	cairo_t *cr;
+	struct rectangle alloc;
+	const char *title = task->title ? task->title : "";
+	int activated = (task->state &
+			 SYNVEIL_SHELL_PANEL_WINDOW_STATE_ACTIVATED) != 0;
+	int minimized = (task->state &
+			 SYNVEIL_SHELL_PANEL_WINDOW_STATE_MINIMIZED) != 0;
+	cairo_text_extents_t extents;
+
+	widget_get_allocation(widget, &alloc);
+	if (alloc.width == 0)
+		return;
+
+	cr = widget_cairo_create(ptask->panel->widget);
+	if (activated || ptask->focused) {
+		sv_rounded_rect(cr, alloc.x, alloc.y, alloc.width,
+				alloc.height, 4);
+		sv_set_rgb(cr, SV_COLOR_SURFACE_HI);
+		cairo_fill(cr);
+	}
+	if (activated) {
+		sv_set_rgb(cr, SV_COLOR_ACCENT);
+		cairo_rectangle(cr, alloc.x + alloc.width / 2 - 12,
+				alloc.y + alloc.height - 3, 24, 3);
+		cairo_fill(cr);
+	}
+	cairo_set_font_size(cr, 12);
+	cairo_text_extents(cr, "Ag", &extents);
+	if (minimized)
+		cairo_set_source_rgb(cr, 0x8A / 255.0, 0x8A / 255.0,
+				     0x8A / 255.0);
+	else if (activated)
+		cairo_set_source_rgb(cr, 1, 1, 1);
+	else
+		cairo_set_source_rgb(cr, 0xC8 / 255.0, 0xC8 / 255.0,
+				     0xC8 / 255.0);
+	cairo_move_to(cr, alloc.x + 10,
+		      alloc.y + alloc.height / 2 + extents.height / 2 - 1);
+	sv_show_text_clipped(cr, title, 12, alloc.width - 20);
+	cairo_destroy(cr);
+}
+
+static int
+panel_task_enter_handler(struct widget *widget, struct input *input,
+			 float x, float y, void *data)
+{
+	struct panel_task *ptask = data;
+
+	ptask->focused = 1;
+	widget_schedule_redraw(widget);
+	return CURSOR_LEFT_PTR;
+}
