+/* Rendered vertical offset of the Start menu card and its
+ * items: the card slides up from behind the strip as menu_p
+ * eases 0 -> 1 over the UI_DESIGN menu duration (200 ms). */
+static double
+sv_menu_dy(struct panel *panel)
+{
+	if (!panel->menu_open)
+		return 0;
+	return (1.0 - panel->menu_p) * sv_menu_height(panel);
+}
