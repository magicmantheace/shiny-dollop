+
+  <interface name="synveil_shell_panel" version="1">
+    <description summary="window list for the desktop shell's own panel">
+      Private protocol between the Weston desktop shell and its
+      own helper client (the panel). The shell publishes the
+      toplevel window list — additions, removals, title/app-id
+      changes and activation/minimize state — and the helper may
+      ask the shell to activate or minimize a published window
+      and reports its Start menu's open state so the shell can
+      dismiss the menu when an unrelated window is activated.
+
+      The compositor honors state-changing requests only from
+      the shell's own launched helper client; any other client
+      that binds the interface receives no events and its
+      requests are ignored. Window ids are shell-assigned,
+      unique for the lifetime of a window, and never reused
+      within a session.
+    </description>
+
+    <enum name="window_state">
+      <entry name="activated" value="1" summary="window has input focus"/>
+      <entry name="minimized" value="2" summary="window is in the minimized layer"/>
+    </enum>
+
+    <event name="window_added">
+      <description summary="a toplevel window appeared"/>
+      <arg name="id" type="uint"/>
+      <arg name="app_id" type="string"/>
+      <arg name="title" type="string"/>
+    </event>
+
+    <event name="window_removed">
+      <description summary="a toplevel window went away"/>
+      <arg name="id" type="uint"/>
+    </event>
+
+    <event name="window_properties_changed">
+      <description summary="a window's app id or title changed"/>
+      <arg name="id" type="uint"/>
+      <arg name="app_id" type="string"/>
+      <arg name="title" type="string"/>
+    </event>
+
+    <event name="window_state_changed">
+      <description summary="a window's state flags changed"/>
+      <arg name="id" type="uint"/>
+      <arg name="state" type="uint" enum="window_state"/>
+    </event>
+
+    <event name="menu_dismiss">
+      <description summary="close the Start menu">
+        Sent when the shell decides the menu must close because
+        an unrelated window was activated while it was open.
+      </description>
+    </event>
+
+    <request name="activate_window">
+      <description summary="activate (raise and focus) a window">
+        Also restores a minimized window, through the shell's
+        normal activation path.
+      </description>
+      <arg name="id" type="uint"/>
+    </request>
+
+    <request name="minimize_window">
+      <description summary="minimize a window"/>
+      <arg name="id" type="uint"/>
+    </request>
+
+    <request name="set_menu_open">
+      <description summary="report the Start menu's open state"/>
+      <arg name="open" type="uint"/>
+    </request>
+  </interface>
+</protocol>
