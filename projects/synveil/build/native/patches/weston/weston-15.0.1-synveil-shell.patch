+static int
+panel_task_motion_handler(struct widget *widget, struct input *input,
+			  uint32_t time, float x, float y, void *data)
+{
+	struct panel_task *ptask = data;
+
+	if (ptask->task->title && ptask->task->title[0])
+		widget_set_tooltip(widget, ptask->task->title, x, y);
+
+	return CURSOR_LEFT_PTR;
+}
+
+static void
+panel_task_button_handler(struct widget *widget, struct input *input,
+			  uint32_t time, uint32_t button,
+			  enum wl_pointer_button_state state, void *data)
+{
+	struct panel_task *ptask = data;
+	struct desktop *desktop = panel_get_desktop(ptask->panel);
+	struct synveil_task *task = ptask->task;
+	int activated = (task->state &
+			 SYNVEIL_SHELL_PANEL_WINDOW_STATE_ACTIVATED) != 0;
+	int minimized = (task->state &
+			 SYNVEIL_SHELL_PANEL_WINDOW_STATE_MINIMIZED) != 0;
+
+	if (state != WL_POINTER_BUTTON_STATE_RELEASED)
+		return;
+	if (!desktop->synveil_panel)
+		return;
+	if (ptask->panel->menu_open)
+		panel_set_menu_open(ptask->panel, 0);
+	if (activated && !minimized)
+		synveil_shell_panel_minimize_window(desktop->synveil_panel,
+						    task->id);
+	else
+		synveil_shell_panel_activate_window(desktop->synveil_panel,
+						    task->id);
+}
+
+static void
+panel_task_destroy(struct panel_task *ptask)
+{
+	widget_destroy(ptask->widget);
+	wl_list_remove(&ptask->link);
+	free(ptask);
+}
+
+static void
+panel_task_create(struct panel *panel, struct synveil_task *task)
+{
+	struct panel_task *ptask = xzalloc(sizeof *ptask);
+
+	ptask->panel = panel;
+	ptask->task = task;
+	ptask->widget = widget_add_widget(panel->widget, ptask);
+	wl_list_insert(panel->task_list.prev, &ptask->link);
+	widget_set_redraw_handler(ptask->widget, panel_task_redraw_handler);
+	widget_set_enter_handler(ptask->widget, panel_task_enter_handler);
+	widget_set_leave_handler(ptask->widget, panel_task_leave_handler);
+	widget_set_button_handler(ptask->widget, panel_task_button_handler);
+	widget_set_motion_handler(ptask->widget, panel_task_motion_handler);
+}
+
+/* Mirror the desktop's window model with this panel's widgets,
+ * then lay out and repaint. */
+static void
+panel_sync_tasks(struct panel *panel, struct desktop *desktop)
+{
+	struct panel_task *ptask, *tmp;
+	struct synveil_task *task;
+	struct rectangle alloc;
+	int found;
+
+	wl_list_for_each_safe(ptask, tmp, &panel->task_list, link) {
+		found = 0;
+		wl_list_for_each(task, &desktop->synveil_tasks, link)
+			if (task == ptask->task)
+				found = 1;
+		if (!found)
+			panel_task_destroy(ptask);
+	}
+	wl_list_for_each(task, &desktop->synveil_tasks, link) {
+		found = 0;
+		wl_list_for_each(ptask, &panel->task_list, link)
+			if (ptask->task == task)
+				found = 1;
+		if (!found)
+			panel_task_create(panel, task);
+	}
+	widget_get_allocation(panel->widget, &alloc);
+	if (alloc.width > 0)
+		panel_layout(panel, alloc.width, alloc.height);
+	widget_schedule_redraw(panel->widget);
+}
