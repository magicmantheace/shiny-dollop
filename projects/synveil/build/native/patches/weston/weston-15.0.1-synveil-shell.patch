+/* ---- Synveil shell panel (ADR 0025): Start button, Start
+ * menu and task buttons in the bottom panel, in the
+ * docs/UI_DESIGN.md tokens. The shell publishes the window
+ * list over the private synveil_shell_panel protocol; every
+ * control drawn here performs a real action: task buttons
+ * activate/minimize through the shell, menu items focus the
+ * app's window when one exists and otherwise launch the app
+ * binary, and the Start button opens and closes the menu.
+ * No session actions are offered: the session machinery
+ * exposes no logout/lock request to invoke. */
+
+#define SV_STRIP_H 48
+#define SV_MENU_ITEM_H 40
+#define SV_MENU_WIDTH 328
+#define SV_COLOR_SURFACE 0x2C2C2C
+#define SV_COLOR_SURFACE_HI 0x383838
+#define SV_COLOR_STROKE 0x454545
+#define SV_COLOR_ACCENT 0x4CC2FF
+#define SV_COLOR_ACCENT_PRESSED 0x38A8E8
+#define SV_COLOR_INK_FAINT 0x8A8A8A
+#define SV_COLOR_DANGER 0xE81123
+
+static void
+sv_set_rgb(cairo_t *cr, uint32_t hex)
+{
+	cairo_set_source_rgb(cr, ((hex >> 16) & 0xff) / 255.0,
+			     ((hex >> 8) & 0xff) / 255.0,
+			     (hex & 0xff) / 255.0);
+}
+
+static void
+sv_rounded_rect(cairo_t *cr, double x, double y, double w, double h,
+		double r)
+{
+	cairo_new_sub_path(cr);
+	cairo_arc(cr, x + w - r, y + r, r, -M_PI / 2, 0);
+	cairo_arc(cr, x + w - r, y + h - r, r, 0, M_PI / 2);
+	cairo_arc(cr, x + r, y + h - r, r, M_PI / 2, M_PI);
+	cairo_arc(cr, x + r, y + r, r, M_PI, 3 * M_PI / 2);
+	cairo_close_path(cr);
+}
+
+static double
+sv_text_width(const char *text, double size)
+{
+	static cairo_surface_t *measure_surface;
+	static cairo_t *measure_cr;
+	cairo_text_extents_t extents;
+
+	if (!measure_cr) {
+		measure_surface = cairo_image_surface_create(
+			CAIRO_FORMAT_ARGB32, 1, 1);
+		measure_cr = cairo_create(measure_surface);
+	}
+	cairo_set_font_size(measure_cr, size);
+	cairo_text_extents(measure_cr, text, &extents);
+	return extents.x_advance;
+}
+
+/* Draw text at the current point, shortened with an ellipsis
+ * when it exceeds max_width. */
+static void
+sv_show_text_clipped(cairo_t *cr, const char *text, double size,
+		     double max_width)
+{
+	cairo_text_extents_t extents;
+	char buf[256];
+	size_t len;
+
+	cairo_set_font_size(cr, size);
+	snprintf(buf, sizeof buf, "%s", text);
+	cairo_text_extents(cr, buf, &extents);
+	if (extents.x_advance <= max_width) {
+		cairo_show_text(cr, buf);
+		return;
+	}
+	len = strlen(buf);
+	while (len > 1) {
+		char trial[260];
+
+		snprintf(trial, sizeof trial, "%.*s…", (int) len, buf);
+		cairo_text_extents(cr, trial, &extents);
+		if (extents.x_advance <= max_width) {
+			cairo_show_text(cr, trial);
+			return;
+		}
+		len--;
+	}
+	cairo_show_text(cr, "…");
+}
+
+static uint64_t
+sv_now_ms(void)
+{
+	struct timespec ts;
+
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t) ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+/* UI_DESIGN motion curve: ease-out cubic approximation of the
+ * Windows 11 curve (fast start, gentle settle, no overshoot). */
+static double
+sv_ease_out_cubic(double t)
+{
+	double u = 1.0 - t;
+
+	return 1.0 - u * u * u;
+}
+
+/* The shell's original geometric marks (shell polish pass),
+ * replacing the menu's letter tiles and the taskbar's generic
+ * glyphs. Every mark is drawn cairo primitives in the UI_DESIGN
+ * tokens plus per-app hues — no artwork files, no third-party
+ * icon sets. Designs sit on a 24-unit grid scaled to size. */
+enum sv_icon {
+	SV_ICON_FILES,
+	SV_ICON_UPDATES,
+	SV_ICON_BROWSER,
+	SV_ICON_TERMINAL,
+	SV_ICON_DEMO,
+	SV_ICON_WINDOW,
+	SV_ICON_NET_UP,
+	SV_ICON_NET_DOWN,
+	SV_ICON_NET_NONE,
+	SV_ICON_UPDATE_READY,
+	SV_ICON_UPDATE_CURRENT
+};
+
+static void
+sv_draw_net_arcs(cairo_t *cr, double u, uint32_t hex, int dot)
+{
+	int i;
+
+	sv_set_rgb(cr, hex);
+	cairo_set_line_width(cr, 2.0 * u);
+	cairo_set_line_cap(cr, CAIRO_LINE_CAP_ROUND);
+	for (i = 0; i < 3; i++) {
+		cairo_arc(cr, 12 * u, 17.5 * u, (5.5 + 3.6 * i) * u,
+			  M_PI * 1.18, M_PI * 1.82);
+		cairo_stroke(cr);
+	}
+	if (dot) {
+		cairo_arc(cr, 12 * u, 17.5 * u, 1.7 * u, 0, 2 * M_PI);
+		cairo_fill(cr);
+	}
+}
+
+static void
+sv_draw_update_arrow(cairo_t *cr, double u, uint32_t hex)
+{
+	sv_set_rgb(cr, hex);
+	cairo_rectangle(cr, 10.2 * u, 3 * u, 3.6 * u, 9 * u);
+	cairo_fill(cr);
+	cairo_move_to(cr, 5 * u, 10 * u);
+	cairo_line_to(cr, 19 * u, 10 * u);
+	cairo_line_to(cr, 12 * u, 18 * u);
+	cairo_close_path(cr);
+	cairo_fill(cr);
+	cairo_rectangle(cr, 4 * u, 20 * u, 16 * u, 2.2 * u);
+	cairo_fill(cr);
+}
+
+static void
+sv_draw_icon(cairo_t *cr, int icon, double x, double y, double size)
+{
+	double u = size / 24.0;
+
+	cairo_save(cr);
+	cairo_translate(cr, x, y);
+	switch (icon) {
+	case SV_ICON_TERMINAL:
+		sv_rounded_rect(cr, 1 * u, 3 * u, 22 * u, 18 * u, 3 * u);
+		sv_set_rgb(cr, 0x202020);
+		cairo_fill_preserve(cr);
+		sv_set_rgb(cr, SV_COLOR_STROKE);
+		cairo_set_line_width(cr, 1);
+		cairo_stroke(cr);
+		sv_set_rgb(cr, 0x7EE787);
+		cairo_set_line_width(cr, 2.2 * u);
+		cairo_set_line_cap(cr, CAIRO_LINE_CAP_ROUND);
+		cairo_move_to(cr, 6 * u, 8 * u);
+		cairo_line_to(cr, 10.5 * u, 12 * u);
+		cairo_line_to(cr, 6 * u, 16 * u);
+		cairo_stroke(cr);
+		cairo_move_to(cr, 12.5 * u, 16.5 * u);
+		cairo_line_to(cr, 18 * u, 16.5 * u);
+		cairo_stroke(cr);
+		break;
+	case SV_ICON_FILES:
+		sv_set_rgb(cr, 0xC77F27);
+		sv_rounded_rect(cr, 2 * u, 6 * u, 20 * u, 13 * u, 2 * u);
+		cairo_fill(cr);
+		cairo_rectangle(cr, 2 * u, 4 * u, 9 * u, 4 * u);
+		cairo_fill(cr);
+		sv_set_rgb(cr, 0xF0B95A);
+		cairo_move_to(cr, 2 * u, 10 * u);
+		cairo_line_to(cr, 22 * u, 10 * u);
+		cairo_line_to(cr, 20.5 * u, 19 * u);
+		cairo_line_to(cr, 3.5 * u, 19 * u);
+		cairo_close_path(cr);
+		cairo_fill(cr);
+		break;
+	case SV_ICON_UPDATES:
+		sv_draw_update_arrow(cr, u, SV_COLOR_ACCENT);
+		break;
+	case SV_ICON_BROWSER:
+		sv_set_rgb(cr, 0x2F5D8A);
+		cairo_arc(cr, 12 * u, 12 * u, 9.5 * u, 0, 2 * M_PI);
+		cairo_fill_preserve(cr);
+		sv_set_rgb(cr, 0xBFD9F2);
+		cairo_set_line_width(cr, 1.1 * u);
+		cairo_stroke(cr);
+		cairo_save(cr);
+		cairo_arc(cr, 12 * u, 12 * u, 9.5 * u, 0, 2 * M_PI);
+		cairo_clip(cr);
+		sv_set_rgb(cr, 0xBFD9F2);
+		cairo_set_line_width(cr, 1.0 * u);
+		cairo_move_to(cr, 2.5 * u, 12 * u);
+		cairo_line_to(cr, 21.5 * u, 12 * u);
+		cairo_stroke(cr);
+		cairo_move_to(cr, 2.5 * u, 7.5 * u);
+		cairo_line_to(cr, 21.5 * u, 7.5 * u);
+		cairo_stroke(cr);
+		cairo_save(cr);
+		cairo_translate(cr, 12 * u, 12 * u);
+		cairo_scale(cr, 0.45, 1.0);
+		cairo_arc(cr, 0, 0, 9.5 * u, 0, 2 * M_PI);
+		cairo_restore(cr);
+		cairo_stroke(cr);
+		cairo_restore(cr);
+		break;
+	case SV_ICON_DEMO:
+		sv_rounded_rect(cr, 2 * u, 4 * u, 20 * u, 16 * u, 2.5 * u);
+		sv_set_rgb(cr, 0x1B4B8F);
+		cairo_fill(cr);
+		cairo_save(cr);
+		sv_rounded_rect(cr, 2 * u, 4 * u, 20 * u, 16 * u, 2.5 * u);
+		cairo_clip(cr);
+		sv_set_rgb(cr, 0x202020);
+		cairo_rectangle(cr, 2 * u, 4 * u, 20 * u, 5 * u);
+		cairo_fill(cr);
+		cairo_restore(cr);
+		sv_set_rgb(cr, SV_COLOR_ACCENT);
+		cairo_arc(cr, 6 * u, 6.5 * u, 1.6 * u, 0, 2 * M_PI);
+		cairo_fill(cr);
+		break;
+	case SV_ICON_WINDOW:
+		sv_rounded_rect(cr, 3 * u, 5 * u, 18 * u, 14 * u, 2 * u);
+		sv_set_rgb(cr, SV_COLOR_SURFACE_HI);
+		cairo_fill_preserve(cr);
+		sv_set_rgb(cr, SV_COLOR_INK_FAINT);
+		cairo_set_line_width(cr, 1.1 * u);
+		cairo_stroke(cr);
+		sv_set_rgb(cr, SV_COLOR_INK_FAINT);
+		cairo_rectangle(cr, 4.5 * u, 9.5 * u, 15 * u, 1.2 * u);
+		cairo_fill(cr);
+		break;
+	case SV_ICON_NET_UP:
+		sv_draw_net_arcs(cr, u, SV_COLOR_ACCENT, 1);
+		break;
+	case SV_ICON_NET_DOWN:
+		sv_draw_net_arcs(cr, u, SV_COLOR_INK_FAINT, 0);
+		sv_set_rgb(cr, SV_COLOR_DANGER);
+		cairo_set_line_width(cr, 2.2 * u);
+		cairo_set_line_cap(cr, CAIRO_LINE_CAP_ROUND);
+		cairo_move_to(cr, 5 * u, 19 * u);
+		cairo_line_to(cr, 19 * u, 5 * u);
+		cairo_stroke(cr);
+		break;
+	case SV_ICON_NET_NONE:
+		sv_draw_net_arcs(cr, u, SV_COLOR_STROKE, 0);
+		break;
+	case SV_ICON_UPDATE_READY:
+		sv_draw_update_arrow(cr, u, SV_COLOR_ACCENT);
+		sv_set_rgb(cr, 0x7EE787);
+		cairo_arc(cr, 17.5 * u, 17.5 * u, 3.4 * u, 0, 2 * M_PI);
+		cairo_fill_preserve(cr);
+		sv_set_rgb(cr, 0x202020);
+		cairo_set_line_width(cr, 1.2 * u);
+		cairo_stroke(cr);
+		break;
+	case SV_ICON_UPDATE_CURRENT:
+		sv_draw_update_arrow(cr, u, SV_COLOR_INK_FAINT);
+		break;
+	}
+	cairo_restore(cr);
+}
